{
  "name": "rwkit",
  "version": "1.1.0",
  "description": "TypeScript parsers for RenderWare DFF, TXD, IFP, and GTA particle effects.",
  "author": {
    "name": "DepsCian",
    "url": "https://github.com/DepsCian"
  },
  "contributors": [
    {
      "name": "Timic3",
      "url": "https://github.com/Timic3"
    },
    {
      "name": "MegadreamsBE",
      "url": "https://github.com/MegadreamsBE"
    }
  ],
  "license": "GPL-3.0",
  "homepage": "https://github.com/DepsCian/RWKit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DepsCian/RWKit.git"
  },
  "keywords": [
    "gta",
    "gtasa",
    "gtavc",
    "gtaiii",
    "san andreas",
    "vice city",
    "iii",
    "renderware",
    "parser",
    "dff",
    "txd",
    "ifp",
    "fxp",
    "rwkit"
  ],
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/node": "^26.6.6",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "bun run build",
    "test": "bun test",
    "check:package": "bash .github/scripts/check-package.sh",
    "bench": "bun benchmarks/run.ts",
    "bench:check": "tsc --noEmit --target es2020 --module commonjs --esModuleInterop --skipLibCheck benchmarks/run.ts"
  },
  "files": [
    "lib",
    "src",
    "LICENSE",
    "README.md",
    "tsconfig.json",
    "CREDITS.md",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "packageManager": "bun@1.4.4",
  "bugs": {
    "url": "https://github.com/DepsCian/RWKit/issues"
  }
}
